{
  "name": "dsh-gamedev",
  "version": "0.2.0",
  "description": "Develop Godot 2D games in DSH: edit scripts and scenes, run and debug.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14",
    "dsh": "0.2.1-rc.2"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./session": "./dist/session.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "bridge/*.py",
    "bridge/README.md",
    "prompts",
    "skills",
    "catalog",
    "contracts",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "locks",
    "docs",
    "THIRD_PARTY_NOTICES.md",
    "resolved-dependencies.json",
    "LICENSE",
    "README.md",
    "scripts/setup.mjs",
    "scripts/setup"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cosmokit": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    }
  },
  "bin": {
    "dsh-gamedev-setup": "scripts/setup.mjs"
  }
}
