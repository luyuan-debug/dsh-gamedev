{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "插件设置数据模型（说明与测试用，不能直接导入 DSH）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enabled",
    "projectRoot",
    "godotExecutable",
    "bridge",
    "allowedOptionalTools",
    "testFrameworkPreference"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "projectRoot": {
      "type": [
        "string",
        "null"
      ],
      "description": "游戏工程的绝对路径；运行时检查实际路径和访问权限。"
    },
    "godotExecutable": {
      "type": [
        "string",
        "null"
      ]
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "executable",
        "endpoint",
        "bridgeUrl",
        "bridgeSecretRef",
        "httpSecretRef"
      ],
      "properties": {
        "id": {
          "const": "godot-editor-mcp"
        },
        "mode": {
          "enum": [
            "stdio",
            "existing-loopback-http"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ],
          "description": "已经安装的固定版本程序路径，不是安装命令。"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ],
          "description": "本机服务地址，不允许重定向到远程或包含密钥；本版 HTTP 模式不可用。"
        },
        "bridgeUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "与 Godot 编辑器插件一致的本机 WebSocket 地址，需要包含端口。"
        },
        "bridgeSecretRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "保存连接令牌的环境变量名称，不是令牌值。"
        },
        "httpSecretRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "HTTP 服务凭据的环境变量名称，与编辑器令牌分开；本版 HTTP 模式不可用。"
        }
      }
    },
    "allowedOptionalTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "gdtoolkit",
          "imagemagick",
          "ffmpeg",
          "pixelorama",
          "gua",
          "dcc-mcp",
          "tiled",
          "ldtk"
        ]
      },
      "default": []
    },
    "testFrameworkPreference": {
      "enum": [
        "existing",
        "none",
        "gut",
        "gdunit4"
      ],
      "default": "existing"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "projectRoot": {
            "type": "string",
            "minLength": 1
          },
          "godotExecutable": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bridge": {
                  "properties": {
                    "mode": {
                      "const": "stdio"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "bridge": {
                  "properties": {
                    "executable": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bridgeUrl": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "bridge": {
                  "properties": {
                    "mode": {
                      "const": "existing-loopback-http"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "bridge": {
                  "properties": {
                    "endpoint": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
