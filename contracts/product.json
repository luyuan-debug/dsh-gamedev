  "compatibilityScope": "coexistence-and-noninterference-not-deep-integration",
  "requiredDeliverables": [
    "source-archive",
    "installable-tarball",
    "minimal-settings-ui",
    "prompt-and-one-skill",
    "resolved-dependencies",
    "real-godot-evidence",
    "acceptance-results",
    "install-uninstall-docs"
  ],
  "requiredFlows": [
    "preset-with-native-engineering-tools",
    "editor-read-write-save-reread",
    "runtime-input-logs-image",
    "existing-project-bug-regression",
    "same-platform-debug-export"
  ],
  "excluded": [
    "multi-role-team-platform",
    "new-task-board",
    "capability-router",
    "custom-mcp-transport",
    "custom-mcp-search",
    "own-memory-database",
    "project-thread-owner",
    "agent-team-owner",
    "nested-team-in-project",
    "automatic-tool-installation",
    "automatic-permission-expansion",
    "upstream-dsh-fork",
    "mandatory-third-party-mcp-manager"
  ],
  "evidenceStatuses": [
    "NOT_RUN",
    "PASS",
    "FAIL",
    "BLOCKED",
    "NOT_APPLICABLE"
  ],
  "sourceLedger": "resolved-dependencies.json",
  "acceptanceMatrix": "acceptance/cases.json"
