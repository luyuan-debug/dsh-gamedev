{
  "schemaVersion": 1,
  "handoffVersion": "1.0.0",
  "targetPluginVersion": "0.2.0",
  "projectName": "dsh-gamedev",
  "preset": {
    "id": "godot-2d",
    "displayName": "Godot 2D",
    "count": 1,
    "prompt": "prompts/godot-2d.md"
  },
  "ownedSkill": {
    "id": "godot-2d-workflow",
    "count": 1,
    "path": "skills/godot-2d-workflow/SKILL.md"
  },
  "newModelCallableTools": [],
  "defaultBridge": "godot-editor-mcp",
  "firstCandidate": {
    "dsh": "0.2.1-rc.2",
    "godot": "4.7.2",
    "bridgeRelease": "2026.10.20.1",
    "verificationReference": "docs/VERIFICATION.md"
  },
  "platformTargets": {
    "primary": "macos-arm64",
    "secondary": "linux-x64",
    "supportPolicy": "See docs/VERIFICATION.md for measured support; target declarations are not acceptance evidence."
  },
  "preserveLanguages": [
    "GDScript",
    "C#",
    "C++"
  ],
  "defaults": {
    "autoInstall": false,
    "autoUpgrade": false,
    "selfEscalation": false,
    "autoPublish": false,
    "bridgeEnabled": false,
    "optionalToolsEnabled": false
